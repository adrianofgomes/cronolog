# Configurações de Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cronolog
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Modo Debug (NUNCA usar true em produção)
APP_DEBUG=false
# Permitir tokens de teste/mock (NUNCA usar true em produção)
ENABLE_TEST_TOKENS=false

# Configurações Google OAuth
GOOGLE_CLIENT_ID=seu_client_id
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Configurações JWT (Sessão Local)
JWT_SECRET=sua_chave_secreta_aleatoria
JWT_EXPIRES_DAYS=30

# Configurações de Deploy
FTP_HOST=ftp.seudominio.com.br
FTP_USER=usuario
FTP_PASS=senha
SSH_PORT=22
